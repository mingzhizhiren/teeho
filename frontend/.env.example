# 说明：配置 Vite 开发服务器的 /api 代理目标；不是浏览器 API 基地址，也不是数据库地址
# 选项：后端根地址的绝对 HTTP(S) URL，不附加 /api；不能使用相对路径
# 类型：URL 字符串
# 示例：API_PROXY_TARGET=http://127.0.0.1:9634
# 补充：仅处理发往 Vite 的 /api 请求，保留请求路径；正式部署需另行配置反向代理。
API_PROXY_TARGET=http://127.0.0.1:9634

# 说明：配置前端请求的后端 API 基地址，需包含后端实际挂载的 `/api` 前缀
# 选项：绝对 HTTP(S) URL 或同站点相对路径
# 类型：URL 字符串
# 示例：VITE_API_BASE_URL=http://localhost:9634/api
# 补充：绝对 URL 由浏览器直连后端，需匹配后端 CORS_ORIGIN；填写 /api 时本地开发才使用上述代理。
VITE_API_BASE_URL=/api

# 说明：配置本地 Vite 开发服务器的监听端口
# 选项：建议使用 1–65535 范围内未被占用的端口
# 类型：正整数
# 示例：VITE_FRONTEND_PORT=8080
VITE_FRONTEND_PORT=8080

# 说明：配置浏览器端用户数据的公开混淆种子；它会进入前端产物，不是真正的密钥
# 选项：任意稳定的项目专用字符串；产生用户密文后不得随意修改，否则旧数据无法解密
# 类型：字符串
# 示例：VITE_TEEHO_PWD=replace-with-a-project-specific-public-seed
VITE_TEEHO_PWD=replace-with-a-project-specific-public-seed
