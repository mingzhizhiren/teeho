{
    "name": "@teeho/community-server",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --env-file=.env --preload ./scripts/register-debug.ts src/app.ts",
        "dev:video-worker": "bun --env-file=.env --preload ./scripts/register-debug.ts src/video/video.worker-entry.ts",
        "start:release": "bun --env-file=.env dist/app.js",
        "start:video-worker:release": "bun --env-file=.env dist/video/video.worker-entry.js",
        "test": "vitest run",
        "build": "tsc --noEmit && bun scripts/build.ts --release",
        "build:debug": "tsc --noEmit && bun scripts/build.ts",
        "lint": "eslint ."
    },
    "dependencies": {
        "@elysiajs/cors": "^1.1.1",
        "@mastra/core": "^1.52.1",
        "@supabase/supabase-js": "^2.110.7",
        "drizzle-orm": "^0.45.2",
        "elysia": "^1.1.23",
        "pino": "^9.4.0",
        "pino-roll": "^4.0.0",
        "postgres": "^3.4.9",
        "sharp": "0.35.3",
        "zod": "^3.23.8",
        "@teeho/content-metrics": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "25.6.0",
        "@electric-sql/pglite": "0.5.8",
        "@types/bun": "1.3.14",
        "eslint": "^9.12.0",
        "typescript": "^5.6.3",
        "vitest": "^2.1.3"
    },
    "exports": {
        "./*": "./src/*.ts"
    }
}
