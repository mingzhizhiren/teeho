# 复制为本目录的 .env，按部署环境填写；不要提交实际密钥。
# 题火使用独立 Supabase 项目；此模板不包含积分、支付、订阅或私有模型配置。

# 说明：配置后端运行环境
# 选项：development | test | production
# 类型：枚举字符串
# 示例：NODE_ENV=development
NODE_ENV=development

# 说明：配置是否启用后端调试模式
# 选项：true | false
# 类型：布尔值字符串
# 示例：DEBUG=false
# DEBUG=true 同时豁免匿名账号的永久机器限额和每日 IP 创建限额；未配置默认 false。
DEBUG=false

# 说明：配置后端 HTTP 服务监听端口
# 选项：建议使用 1–65535 范围内未被占用的端口
# 类型：正整数
# 示例：PORT=9634
PORT=9634

# 说明：配置允许携带凭据访问后端的前端来源
# 选项：精确的 HTTP(S) 浏览器 Origin；留空时禁用跨域响应
# 类型：URL 字符串或空字符串
# 示例：CORS_ORIGIN=http://127.0.0.1:8080
CORS_ORIGIN=http://127.0.0.1:8080

# 说明：配置浏览器可访问的后端根地址，Google OAuth 回调会基于此地址生成
# 选项：客户端可访问的绝对 HTTP(S) 根地址；本地可用 localhost，远程使用可达的部署地址
# 类型：URL 字符串
# 示例：PUBLIC_API_URL=http://127.0.0.1:9634
# Skill 下载包也使用此公开入口自动生成 API 地址（末尾 /api 自动补齐）。
# 本地填写本机 HTTP 地址，线上填写客户端可访问的 HTTPS 地址；不能填写容器内部地址。
PUBLIC_API_URL=http://127.0.0.1:9634

# 说明：配置服务端加密与签名密钥，用于临时数据加密、Cookie 或事件令牌签名等；不得暴露给前端
# 选项：非空字符串；各环境产生密文后应保持稳定
# 类型：非空秘密字符串
# 示例：TEEHO_PWD=replace_with_stable_random_server_secret
# 补充：示例值仅供开发；部署时使用独立随机密钥，不与 VITE_TEEHO_PWD 共用。
TEEHO_PWD=replace_with_stable_random_server_secret

# 说明：配置本次部署 Supabase 项目的 API 地址；不要指向其他部署的项目
# 选项：部署者自己的 Supabase 项目 URL
# 类型：URL 字符串
# 示例：SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# 说明：配置 Supabase 客户端公开密钥，只能使用 publishable key 或旧版 anon key
# 选项：非空公开客户端密钥；禁止填写 secret key 或 service_role key
# 类型：字符串
# 示例：SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key

# 说明：配置后端管理匿名账号、访问私有 Storage 等所需的 Supabase 高权限密钥；只能存在于服务端
# 选项：Supabase secret key 或旧版 service_role key
# 类型：秘密字符串
# 示例：SUPABASE_SECRET_KEY=replace_with_your_server_secret_key
SUPABASE_SECRET_KEY=replace_with_your_server_secret_key

# 说明：配置 Drizzle 运行时查询使用的 PostgreSQL 连接串，不负责执行 migration
# 选项：postgres:// 或 postgresql:// 协议的数据库连接串
# 类型：数据库 URL 字符串
# 本地栈可使用直连地址；IPv4-only 环境连接 Supabase 云项目时使用 Supavisor Session 模式（端口 5432）。
# 工作台事件依赖持久 LISTEN，不能使用 Supavisor Transaction 模式（端口 6543）。
# 示例：DATABASE_DIRECT_URL=postgresql://postgres:replace_with_password@your-database-host:5432/postgres
# 补充：仅连接已执行本目录迁移的独立数据库，不混用其他部署的任务表或迁移历史。
DATABASE_DIRECT_URL=postgresql://postgres:replace_with_password@your-database-host:5432/postgres

# 说明：配置每个后端进程的数据库连接池上限；API 与视频 Worker 分别创建连接池
# 选项：大于 0 的整数
# 类型：正整数
# 示例：DATABASE_POOL_MAX=5
DATABASE_POOL_MAX=5

# 说明：配置数据库空闲连接的回收等待时间
# 选项：大于或等于 0 的秒数
# 类型：非负整数
# 示例：DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_IDLE_TIMEOUT_SECONDS=20

# 说明：配置建立数据库连接的最长等待时间
# 选项：大于 0 的秒数
# 类型：正整数
# 示例：DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# 说明：配置部署模式标识；此部署不包含积分和支付，修改此项不会启用商业模块
# 选项：cloud | local；自部署使用 local
# 类型：枚举字符串
# 示例：TEEHO_DEPLOYMENT_MODE=local
TEEHO_DEPLOYMENT_MODE=local

# 说明：配置数据源、六维算法与自定义展示指标的插件模块；示例插件仅包含合成数据
# 选项：受信任模块的绝对路径或相对于进程工作目录的路径；不可留空
# 类型：文件路径字符串
# 示例：TEEHO_PLUGIN_CONFIG=../plugins/example/config.ts
# 补充：从 server 目录运行源码时使用 ../plugins/example/config.ts；运行构建产物时使用 ./dist/plugins/example/config.js。
TEEHO_PLUGIN_CONFIG=../plugins/example/config.ts

# 说明：配置洞察引擎开关；默认未装配洞察预测器，应保持 false，主分使用六维平均分
# 选项：false；仅设置 true 不会提供私有模型能力
# 类型：布尔值字符串
# 示例：TEEHO_INSIGHT_ENABLED=false
TEEHO_INSIGHT_ENABLED=false

# 说明：独立控制是否签发新的视频上传资格；关闭后已接受的视频仍继续处理
# 选项：true | false
# 类型：布尔值字符串
# 示例：VIDEO_ENABLED=true
VIDEO_ENABLED=true

# 说明：配置笔记分析 Agent 使用的后端 Provider，前端不可读取或选择；mock 仅供演示和测试
# 选项：mock | codex-cli | openai | gemini（单选）
# 类型：枚举字符串
# 示例：TEEHO_AGENT_PROVIDER=mock
TEEHO_AGENT_PROVIDER=mock

# 说明：配置笔记分析 Agent 使用的模型标识
# 选项：mock 时必须留空；codex-cli、openai、gemini 时必须填写对应模型标识
# 类型：最长 200 个字符的字符串或空字符串
# 示例：TEEHO_AGENT_MODEL=
TEEHO_AGENT_MODEL=

# 说明：可选配置任务形成与意图理解使用的 Codex 模型；留空时在进程启动时静态使用 TEEHO_AGENT_MODEL
# 选项：仅 codex-cli 使用；mock 时必须留空；其他真实 Provider 不使用此独立模型配置
# 类型：最长 200 个字符的字符串或空字符串
# 示例：TEEHO_TASK_FORMATION_AGENT_MODEL=
TEEHO_TASK_FORMATION_AGENT_MODEL=

# 说明：配置每次 Provider 调用的最长等待时间
# 选项：1～600 秒
# 类型：正整数
# 示例：TEEHO_AGENT_TIMEOUT_SECONDS=180
TEEHO_AGENT_TIMEOUT_SECONDS=180

# 说明：配置单个后端进程允许同时执行的 Provider 调用数
# 选项：大于 0 的整数
# 类型：正整数
# 示例：TEEHO_AGENT_MAX_CONCURRENCY=1
TEEHO_AGENT_MAX_CONCURRENCY=1

# 说明：配置 OpenAI Provider 的服务端 API Key，仅在 TEEHO_AGENT_PROVIDER=openai 时必填
# 选项：OpenAI API Key | 空字符串
# 类型：秘密字符串
# 示例：OPENAI_API_KEY=
OPENAI_API_KEY=

# 说明：配置 Gemini Provider 的服务端 API Key，仅在 TEEHO_AGENT_PROVIDER=gemini 时必填
# 选项：Gemini API Key | 空字符串
# 类型：秘密字符串
# 示例：GEMINI_API_KEY=
GEMINI_API_KEY=

# 说明：配置 Codex CLI Provider 在后端本机执行，或连接远程 Codex App Server
# 选项：local | remote（单选）
# 类型：枚举字符串
# 示例：TEEHO_CODEX_MODE=local
TEEHO_CODEX_MODE=local

# 说明：配置 local 模式调用的 Codex CLI 可执行文件
# 选项：PATH 中的命令名或可执行文件绝对路径；remote 模式不会使用
# 类型：非空文件路径字符串
# 示例：TEEHO_CODEX_CLI_PATH=codex
TEEHO_CODEX_CLI_PATH=codex

# 说明：配置 remote 模式连接的 Codex App Server WebSocket 地址
# 选项：ws:// 或 wss:// URL；local 模式留空，跨公网应使用安全代理提供 wss://
# 类型：WebSocket URL 字符串或空字符串
# 示例：TEEHO_CODEX_REMOTE_URL=
TEEHO_CODEX_REMOTE_URL=

# 说明：配置 remote 模式连接 Codex App Server 的 capability token
# 选项：与 codex app-server --ws-token-file 中的令牌完全一致；local 模式留空
# 类型：秘密字符串
# 示例：TEEHO_CODEX_REMOTE_TOKEN=
TEEHO_CODEX_REMOTE_TOKEN=

# 说明：配置每个账号的 Agent 发送限流窗口长度
# 选项：大于 0 的秒数
# 类型：正整数
# 示例：TEEHO_AGENT_SEND_WINDOW_SECONDS=60
TEEHO_AGENT_SEND_WINDOW_SECONDS=60

# 说明：配置每个账号在发送限流窗口内允许的请求次数
# 选项：大于 0 的整数
# 类型：正整数
# 示例：TEEHO_AGENT_SEND_LIMIT=10
TEEHO_AGENT_SEND_LIMIT=10

# 说明：配置单次会话的 Token 预算；是资源限制，不是积分收费
# 选项：大于 0 的 Token 数
# 类型：正整数
# 示例：TEEHO_AGENT_SESSION_TOKEN_BUDGET=60000
TEEHO_AGENT_SESSION_TOKEN_BUDGET=60000

# 说明：配置账号累计 Agent 用量的滚动统计窗口
# 选项：大于 0 的秒数
# 类型：正整数
# 示例：TEEHO_AGENT_ROLLING_WINDOW_SECONDS=86400
TEEHO_AGENT_ROLLING_WINDOW_SECONDS=86400

# 说明：配置每个账号在滚动窗口内允许消耗的 Token 上限
# 选项：大于 0 的 Token 数
# 类型：正整数
# 示例：TEEHO_AGENT_ROLLING_TOKEN_LIMIT=1000000
TEEHO_AGENT_ROLLING_TOKEN_LIMIT=1000000

# 说明：配置提交给 Agent 的图片最长边上限
# 选项：1～4096 像素
# 类型：正整数
# 示例：TEEHO_AGENT_IMAGE_MAXIMUM_EDGE=2048
TEEHO_AGENT_IMAGE_MAXIMUM_EDGE=2048

# 说明：配置 Pino 输出日志的最低级别
# 选项：fatal | error | warn | info | debug | trace | silent
# 类型：枚举字符串
# 示例：LOG_LEVEL=info
LOG_LEVEL=info

# 说明：配置 JSON 日志文件目录；留空时发布构建输出 JSON 到 stdout，调试构建输出精简控制台日志
# 选项：目录的绝对或相对路径 | 空字符串
# 类型：目录路径字符串
# 示例：LOG_FILE_DIR=
LOG_FILE_DIR=

# 说明：配置每日滚动日志保留的历史文件数量
# 选项：大于 0 的整数
# 类型：正整数
# 示例：LOG_FILE_RETENTION_DAYS=14
LOG_FILE_RETENTION_DAYS=14

# 说明：配置 HTTPS 证书文件路径；不启用 HTTPS 时留空
# 选项：PEM 证书文件的绝对或相对路径 | 空字符串
# 类型：文件路径字符串
# 示例：HTTPS_CERT_PATH=
# 补充：与 HTTPS_KEY_PATH 配套填写；相对路径从后端工作目录解析。由反向代理终止 TLS 时两项均留空。
HTTPS_CERT_PATH=

# 说明：配置 HTTPS 私钥文件路径；不启用 HTTPS 时留空
# 选项：PEM 私钥文件的绝对或相对路径 | 空字符串
# 类型：文件路径字符串
# 示例：HTTPS_KEY_PATH=
HTTPS_KEY_PATH=
