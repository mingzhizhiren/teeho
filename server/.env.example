# 复制为 .env，填入你自己的服务配置。不要提交 .env。
NODE_ENV=development
DEBUG=false
PORT=9634
CORS_ORIGIN=http://127.0.0.1:8080
PUBLIC_API_URL=http://127.0.0.1:9634

# 服务端设备 Cookie 签名等用途；使用独立、稳定的随机密钥，不与前端种子共用。
TEEHO_PWD=replace_with_stable_random_server_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
SUPABASE_SECRET_KEY=replace_with_your_server_secret_key
DATABASE_DIRECT_URL=postgresql://postgres:replace_with_password@your-database-host:5432/postgres
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# 示例插件只有合成数据；社区默认使用六维平均分，不加载私有模型。
TEEHO_DEPLOYMENT_MODE=local
TEEHO_PLUGIN_CONFIG=../plugins/example/config.ts
TEEHO_INSIGHT_ENABLED=false
VIDEO_ENABLED=true

# mock 仅供演示/测试。真实诊断选择 openai、gemini 或 codex-cli，并配置模型。
TEEHO_AGENT_PROVIDER=mock
TEEHO_AGENT_MODEL=
TEEHO_TASK_FORMATION_AGENT_MODEL=
TEEHO_AGENT_TIMEOUT_SECONDS=180
TEEHO_AGENT_MAX_CONCURRENCY=1
OPENAI_API_KEY=
GEMINI_API_KEY=
TEEHO_CODEX_MODE=local
TEEHO_CODEX_CLI_PATH=codex
TEEHO_CODEX_REMOTE_URL=
TEEHO_CODEX_REMOTE_TOKEN=

# 自部署资源限制，对所有账号使用相同策略；没有积分、订阅或支付。
TEEHO_AGENT_SEND_WINDOW_SECONDS=60
TEEHO_AGENT_SEND_LIMIT=10
TEEHO_AGENT_SESSION_TOKEN_BUDGET=60000
TEEHO_AGENT_ROLLING_WINDOW_SECONDS=86400
TEEHO_AGENT_ROLLING_TOKEN_LIMIT=1000000
TEEHO_AGENT_IMAGE_MAXIMUM_EDGE=2048

# 可选日志目录和 TLS 文件路径；留空时由反向代理提供 HTTPS。
LOG_LEVEL=info
LOG_FILE_DIR=
LOG_FILE_RETENTION_DAYS=14
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
